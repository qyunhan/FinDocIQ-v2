%% Pipeline structure as-wired 2026-07-08 (source of docs/diagrams/2026-07-08-pipeline-structure.png)
%% Red = missing/unwired · amber = flag/dead-letter paths · dotted = designed dependency not yet consumed
flowchart TD
  PDF["PDF — Pillar 3 quarterly"] --> SIG

  subgraph S1["STAGE 1 — ROUTE · scan.py · deterministic, 0 tokens, ~350ms/page"]
    SIG["per-page signals<br/>section = running-header regex (top 14% of page)<br/>ruled = find_tables fragment bboxes<br/>bscore = aligned numeric right-edge rows<br/>num_cov = numeric tokens inside fragments / all numeric tokens"]
    SIG --> CLS{"classify()<br/>coverage-gated"}
    CLS -- "cov >= 0.80<br/>fragments ARE content" --> BM["BORDERED_MULTI / SINGLE<br/>one sibling unit per fragment<br/>col_signature via merge_map grid"]
    CLS -- "cov < 0.50, bscore >= 3<br/>fragments are DECOYS" --> BLM["BORDERLESS_MAIN<br/>one main-region unit<br/>decoy fragments dropped + audited"]
    CLS -- "cov 0.50–0.80" --> MR["MIXED_REVIEW<br/>flag only, no units — don't guess"]
    CLS -- "no numbers" --> NT["NO_TABLE — skip"]
    BM --> TM["template match per unit<br/>title keyword AND >= 60% of<br/>template_col leaf headers on page"]
    BLM --> TM
    TM --> SA["stamp structure_authority<br/>ruled render → merge_map<br/>borderless render → template_cell"]
    SA --> RJ["route JSON + route_map.html"]
  end

  subgraph REG["TEMPLATE REGISTRY — manual seed (tolerated debt)"]
    TC["template_col<br/>ordered leaf headers + group banners<br/>= the column AXIS, not just labels"]
    TR["template_row<br/>row concepts"]
    TCELL["template_cell<br/>per-cell merge + shade truth"]
  end
  TC -. "match signature + ncols" .-> TM

  MB["MANIFEST BUILDER — MISSING STAGE<br/>route JSONs → period-unit grouping,<br/>spanning, exclusions → fleet manifest<br/>(nsfr_manifest.json was hand-built)"]
  RJ --> MB

  subgraph S2["STAGE 2 — EXTRACT · extract_run.py · one command through Stage 4"]
    FR{"framing_for_route<br/>(route class family)"}
    FR -- "BORDERED_*" --> FRULED["framing = ruled<br/>prompt lead: drawn lines are the grid<br/>payload: PDF page only"]
    FR -- "BORDERLESS_*" --> FBLESS["framing = borderless<br/>prompt lead: infer columns from<br/>aligned numeric right edges<br/>payload: PDF page + rendered PNG"]
    FRULED --> CALL["one Gemini call per unit page<br/>pinned 3.5-flash · temp 0 · thinking 0<br/>spanning pages 2+: continuation prompt with<br/>previous page's REAL column labels injected"]
    FBLESS --> CALL
    CALL -- "transport error" --> RETRY["retry same model x3<br/>then FLAG — never model swap"]
    CALL --> HTML["route/out/extract/&lt;doc&gt;/&lt;page&gt;.html<br/>(replayable: --from-html)"]
  end

  MB --> FR

  UNWIRED["designed but UNWIRED framings<br/>MULTIPLE (several sections, one page)<br/>KNOWN-TABLE row-list modifier (from template_row)"]
  UNWIRED -.-> FR

  HTML --> S3["STAGE 3 — PARSE + LOAD<br/>html_to_cells (dialect-hardened)<br/>→ idempotent loader → final.db"]

  S3 --> S4["STAGE 4 — POST-LOAD GATE · default on, no off switch<br/>verify_cells: every value_num re-found VERBATIM<br/>in the PDF text layer (words_from_chars tokenizer)<br/>miss → FLAG + report JSON + exit 1 · VALUES ONLY"]

  SA -. "designated consumer = V2 structure check<br/>NOT YET WIRED — nothing reads it today" .-> S4
  TCELL -. "waiting on V2" .-> S4

  S4 --> S5["STAGE 5 — STAMP + DRIFT · stamp.py<br/>rows → registry concepts · drift → review CSV"]
  TR -. "concepts" .-> S5

  S5 --> CONS["consumers<br/>nsfr_slide.py (pptx/PDF) · app/chat_report.py"]

  classDef missing fill:#ffe3e3,stroke:#d64545,stroke-width:2px,color:#7a1f1f
  class MB,UNWIRED missing
  classDef warn fill:#fff3d1,stroke:#c98500,color:#6b4a00
  class MR,RETRY warn
  classDef ghost fill:#f2f2ef,stroke:#898781,color:#52514e
  class NT ghost
